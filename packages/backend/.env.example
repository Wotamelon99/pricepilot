# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://pricepilot:pricepilot@localhost:5432/pricepilot

# --- Redis ---
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Public backend URL (used to build absolute click-redirect links) ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Amazon PA-API / Associates (Germany marketplace) ---
# Partner/Associate tag is not a secret by itself, but access keys are.
AMAZON_PARTNER_TAG=pricepilot0b7-21
AMAZON_MARKETPLACE=www.amazon.de
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=eu-west-1
AMAZON_HOST=webservices.amazon.de

# --- Awin ---
AWIN_PUBLISHER_ID=3099235
AWIN_API_TOKEN=
AWIN_REGION=DE

# --- Demo provider ---
# Always enabled in development so the API is usable without any credentials.
DEMO_PROVIDER_ENABLED=true
