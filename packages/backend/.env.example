# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://pricepilot:pricepilot@localhost:5432/pricepilot

# --- Redis ---
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Public backend URL (used to build absolute click-redirect links) ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Amazon Creators API / Associates (Germany marketplace) ---
# PA-API 5.0 was retired by Amazon; this now targets the Creators API,
# which uses an OAuth2 Credential ID/Secret pair (generated separately at
# https://affiliate-program.amazon.com/creatorsapi), NOT an AWS key pair.
# Partner/Associate tag is not a secret by itself, but credentials are.
AMAZON_PARTNER_TAG=pricepilot0b7-21
AMAZON_MARKETPLACE=www.amazon.de
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREATORS_API_HOST=creatorsapi.amazon

# --- Awin ---
# Awin has no live cross-advertiser search API - product data must be
# imported locally via `npm run sync:awin` (see src/lib/awin-feed-sync.ts)
# from the datafeeds of merchant programs this publisher account has
# joined. AWIN_API_TOKEN is the "API Credential" generated under
# MyAwin > Account > API Credentials (used both for feed downloads here).
AWIN_PUBLISHER_ID=3099235
AWIN_API_TOKEN=
AWIN_REGION=DE
AWIN_PRODUCTDATA_HOST=productdata.awin.com

# --- Demo provider ---
# Always enabled in development so the API is usable without any credentials.
DEMO_PROVIDER_ENABLED=true
